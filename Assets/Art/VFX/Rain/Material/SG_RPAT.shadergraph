{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "66239702866e4edb98e00efe59537734",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Ripple2 (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1452.666748046875,
            "y": 360.666748046875,
            "width": 209.3333740234375,
            "height": 351.99993896484377
        }
    },
    "m_Slots": [
        {
            "m_Id": "156402315cd84032aedcee49899f1e9b"
        },
        {
            "m_Id": "15b49c710f2a476b91f611e0f8f33e65"
        },
        {
            "m_Id": "59ffe25123a247ba8b03ea28d05a494d"
        },
        {
            "m_Id": "c6cf993374b4444d99ec15212cdd2754"
        },
        {
            "m_Id": "026635bafd5c491394eb249c6b4f60df"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Ripple2",
    "m_FunctionSource": "",
    "m_FunctionBody": "// 初始化输出，避免未完全赋值的编译错误\r\nOut = float4(0.0, 0.0, 0.0, 1.0);\r\n\r\n// 原代码：\r\n// float emissive = 1 - frac(_Time * _Speed);\r\nfloat emissive =\r\n    1.0 - frac(TimeValue * Speed);\r\n\r\nfloat emissive2 =\r\n    1.0 - frac(TimeValue * Speed + 0.5);\r\n\r\n// 原代码：\r\n// SAMPLE_TEXTURE2D(_MaskMap, sampler_MaskMap, IN.uv)\r\nfloat3 mask =\r\n    SAMPLE_TEXTURE2D(\r\n        MaskMap.tex,\r\n        MaskMap.samplerstate,\r\n        UV\r\n    ).rgb;\r\n\r\nfloat3 mask2 =\r\n    SAMPLE_TEXTURE2D(\r\n        MaskMap.tex,\r\n        MaskMap.samplerstate,\r\n        UV + float2(0.5, 0.5)\r\n    ).rgb;\r\n\r\nfloat maskValue =\r\n    saturate(\r\n        1.0 -\r\n        distance(\r\n            mask.r - emissive,\r\n            0.05\r\n        ) / 0.05\r\n    ) * mask.r;\r\n\r\nfloat maskValue2 =\r\n    saturate(\r\n        1.0 -\r\n        distance(\r\n            mask2.r - emissive2,\r\n            0.05\r\n        ) / 0.05\r\n    ) * mask2.r;\r\n\r\nfloat maskColor =\r\n    maskValue + maskValue2;\r\n\r\nfloat3 finalColor =\r\n    float3(\r\n        maskColor,\r\n        maskColor,\r\n        maskColor\r\n    );\r\n\r\n// 原来的 return 改成给输出端口赋值\r\nOut = half4(finalColor, 1.0);"
}

