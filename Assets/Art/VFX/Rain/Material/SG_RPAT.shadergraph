{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "229d7c1f397e4c54ba718713a6831d9c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "RandomRipples (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1004.6666259765625,
            "y": -11.333309173583985,
            "width": 244.0,
            "height": 399.9999084472656
        }
    },
    "m_Slots": [
        {
            "m_Id": "df5cc0ebaa9c4cd2a65ce36700392a47"
        },
        {
            "m_Id": "100dfd9ffa59401980e27dea924c5973"
        },
        {
            "m_Id": "90a0aaa37ef64a1f9ffd0cd2e9a9bb33"
        },
        {
            "m_Id": "aa59be69b4394a7b89b3a3e4e9cefbe5"
        },
        {
            "m_Id": "81528ba7351d4848bcf1b2fa30f362e9"
        },
        {
            "m_Id": "3d59dbed2be941df839738030e089634"
        },
        {
            "m_Id": "d0ce1a5fba7d4823a15090922ef18f30"
        },
        {
            "m_Id": "cb1275e961b5477eb6e8050518b65ef1"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RandomRipples",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 p = UV * max(Density, 0.001);\r\nfloat2 baseCell = floor(p);\r\nfloat2 localPosition = frac(p);\r\n\r\nfloat2 gradient = float2(0.0, 0.0);\r\nfloat rippleResult = 0.0;\r\n\r\nfor (int y = -1; y <= 1; y++)\r\n{\r\n    for (int x = -1; x <= 1; x++)\r\n    {\r\n        float2 neighbour = float2((float)x, (float)y);\r\n        float2 cell = baseCell + neighbour;\r\n\r\n        float phase = frac(\r\n            sin(dot(cell, float2(41.37, 289.11))) * 43758.5453\r\n        );\r\n\r\n        float rippleTime = TimeValue * Speed + phase;\r\n        float cycle = floor(rippleTime);\r\n        float age = frac(rippleTime);\r\n\r\n        float2 seed = cell + cycle * float2(17.17, 73.73);\r\n\r\n        float2 randomPosition = frac(\r\n            sin(\r\n                float2(\r\n                    dot(seed, float2(127.1, 311.7)),\r\n                    dot(seed, float2(269.5, 183.3))\r\n                )\r\n            ) * 43758.5453\r\n        );\r\n\r\n        float chance = frac(\r\n            sin(dot(seed, float2(12.9898, 78.233))) * 43758.5453\r\n        );\r\n\r\n        float active = step(0.35, chance);\r\n\r\n        float2 delta = neighbour + randomPosition - localPosition;\r\n        float distanceToDrop = max(length(delta), 0.0001);\r\n\r\n        float radius = age * 0.75;\r\n        float ringPosition =\r\n            (distanceToDrop - radius) / max(Width, 0.001);\r\n\r\n        float lifetime =\r\n            smoothstep(0.02, 0.10, age) *\r\n            (1.0 - smoothstep(0.65, 0.98, age));\r\n\r\n        float ring =\r\n            exp(-ringPosition * ringPosition) *\r\n            lifetime *\r\n            active;\r\n\r\n        rippleResult = max(rippleResult, ring);\r\n\r\n        float slope = -2.0 * ringPosition * ring;\r\n\r\n        gradient +=\r\n            slope *\r\n            (delta / distanceToDrop);\r\n    }\r\n}\r\n\r\nNormalOut = normalize(\r\n    float3(\r\n        -gradient.x * Strength,\r\n        -gradient.y * Strength,\r\n        1.0\r\n    )\r\n);\r\n\r\nRippleMask = saturate(rippleResult);"
}

