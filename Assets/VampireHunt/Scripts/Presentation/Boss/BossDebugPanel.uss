:root {
    --debug-bg: rgba(12, 8, 13, 0.96);
    --debug-panel: rgba(31, 17, 24, 0.96);
    --debug-border: rgb(142, 47, 66);
    --debug-accent: rgb(232, 66, 91);
    --debug-gold: rgb(232, 189, 92);
    --debug-text: rgb(242, 232, 225);
    --debug-muted: rgb(181, 154, 153);
}

.boss-debug {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 390px;
    max-height: 94%;
    padding: 12px;
    color: var(--debug-text);
    background-color: var(--debug-bg);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--debug-border);
    border-right-color: var(--debug-border);
    border-top-color: var(--debug-border);
    border-bottom-color: var(--debug-border);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.boss-debug__header,
.boss-debug__row,
.boss-debug__section-header {
    flex-direction: row;
    align-items: center;
}

.boss-debug__title {
    flex-grow: 1;
    font-size: 17px;
    color: var(--debug-accent);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.boss-debug__badge {
    padding: 3px 7px;
    color: rgb(24, 14, 10);
    background-color: var(--debug-gold);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 10px;
    -unity-font-style: bold;
}

.boss-debug__status {
    margin-top: 7px;
    margin-bottom: 8px;
    padding: 6px;
    color: var(--debug-muted);
    background-color: rgba(0, 0, 0, 0.36);
    white-space: normal;
    font-size: 11px;
}

.boss-debug__master {
    margin-bottom: 7px;
    padding: 7px;
    color: var(--debug-text);
    background-color: rgba(138, 34, 54, 0.38);
    -unity-font-style: bold;
}

.boss-debug__toggle {
    margin-bottom: 7px;
    color: var(--debug-text);
}

.boss-debug__section-title {
    margin-top: 7px;
    margin-bottom: 5px;
    color: var(--debug-gold);
    font-size: 11px;
    -unity-font-style: bold;
}

.boss-debug__section-title--inline {
    flex-grow: 1;
}

.boss-debug__stage-button {
    flex-grow: 1;
    margin-right: 4px;
    height: 28px;
    color: var(--debug-text);
    background-color: var(--debug-panel);
    border-bottom-color: var(--debug-border);
}

.boss-debug__cancel-button {
    height: 25px;
    color: rgb(255, 214, 219);
    background-color: rgba(116, 29, 42, 0.75);
}

.boss-debug__scroll {
    height: 300px;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.28);
}

.boss-debug__ability-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.boss-debug__ability-button {
    width: 48%;
    height: 29px;
    margin: 2px;
    color: var(--debug-text);
    background-color: var(--debug-panel);
    border-left-color: var(--debug-border);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.boss-debug__ability-button:hover,
.boss-debug__stage-button:hover {
    background-color: rgba(121, 33, 51, 0.9);
}

.boss-debug__feedback {
    margin-top: 7px;
    min-height: 20px;
    color: rgb(224, 174, 182);
    white-space: normal;
    font-size: 11px;
}
